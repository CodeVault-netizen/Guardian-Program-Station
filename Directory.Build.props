<Project>

  <!-- Single source of truth for the application version. Every project
       (Core, Application, Infrastructure, Kernel, UI, Cli, Tests) inherits
       this so the version option and file versions stay consistent. -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <!-- Keep the version option clean: no git hash suffix. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
