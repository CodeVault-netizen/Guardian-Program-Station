<UserControl x:Class="Guardian.ProgramStation.UI.Views.DashboardView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Margin="16">
    <StackPanel Spacing="16">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding DashboardLabel}"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{DynamicResource GpsAccentText}"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Content="{Binding RefreshLabel}"
                Command="{Binding RefreshCommand}" />
      </Grid>

      <Grid ColumnDefinitions="*,*,*"
            ColumnSpacing="12">
        <Border Background="{DynamicResource GpsElement}"
                BorderBrush="{DynamicResource GpsBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                MinHeight="80">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding TotalProgramsText}"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource GpsAccentText}" />
            <TextBlock Text="{Binding TotalProgramsLabel}"
                       FontSize="13"
                       Opacity="0.85" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Background="{DynamicResource GpsElement}"
                BorderBrush="{DynamicResource GpsBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                MinHeight="80">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding TotalSizeText}"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource GpsAccentText}" />
            <TextBlock Text="{Binding TotalSizeLabel}"
                       FontSize="13"
                       Opacity="0.85" />
          </StackPanel>
        </Border>

        <Border Grid.Column="2"
                Background="{DynamicResource GpsElement}"
                BorderBrush="{DynamicResource GpsBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                MinHeight="80">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding TotalFolders, StringFormat={}{0:N0}}"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource GpsAccentText}" />
            <TextBlock Text="{Binding TotalFoldersLabel}"
                       FontSize="13"
                       Opacity="0.85" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid ColumnDefinitions="*,*"
            ColumnSpacing="12">
        <Border Background="{DynamicResource GpsElement}"
                BorderBrush="{DynamicResource GpsBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                MinHeight="80">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding NewProgramsText}"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource GpsAccentText}" />
            <TextBlock Text="{Binding NewProgramsLabel}"
                       FontSize="13"
                       Opacity="0.85" />
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Background="{DynamicResource GpsElement}"
                BorderBrush="{DynamicResource GpsBorder}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                MinHeight="80">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding LastUpdateText}"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="{DynamicResource GpsAccentText}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding LastUpdateLabel}"
                       FontSize="13"
                       Opacity="0.85" />
          </StackPanel>
        </Border>
      </Grid>

      <StackPanel Spacing="8">
        <TextBlock Text="{Binding TypeDistributionLabel}"
                   FontSize="15"
                   FontWeight="Bold" />
        <ItemsControl ItemsSource="{Binding TypeStats}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Width="150"
                      Margin="0,0,10,10"
                      Padding="12"
                      CornerRadius="6"
                      Background="{DynamicResource GpsElement}"
                      BorderBrush="{DynamicResource GpsBorder}"
                      BorderThickness="1">
                <StackPanel Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Icon}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource GpsAccent}" />
                    <TextBlock Text="{Binding Name}"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource GpsAccentText}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Count}"
                             FontSize="22"
                             FontWeight="Bold" />
                  <TextBlock Text="{Binding PercentageText}"
                             FontSize="12"
                             Foreground="{DynamicResource GpsAccent}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel Spacing="8">
        <TextBlock Text="{Binding RecentProgramsLabel}"
                   FontSize="15"
                   FontWeight="Bold" />
        <ListBox ItemsSource="{Binding RecentPrograms}"
                 Height="190">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="2*,1*,Auto"
                    ColumnSpacing="12">
                <TextBlock Text="{Binding Name}"
                           Foreground="{DynamicResource GpsAccentText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Version}"
                           VerticalAlignment="Center"
                           Opacity="0.8"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           Text="{Binding AddedAtText}"
                           VerticalAlignment="Center"
                           Opacity="0.6" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
