<UserControl x:Class="Guardian.ProgramStation.UI.Views.SettingsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Margin="16">
    <StackPanel Spacing="16"
                MaxWidth="760"
                HorizontalAlignment="Left">
      <Border Background="{DynamicResource GpsElement}"
              BorderBrush="{DynamicResource GpsBorder}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding LanguageLabel}"
                     FontSize="15"
                     FontWeight="Bold"
                     Foreground="{DynamicResource GpsAccentText}" />
          <ListBox ItemsSource="{Binding LanguageOptions}"
                   SelectedItem="{Binding SelectedLanguageDisplay, Mode=TwoWay}"
                   Height="88" />
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource GpsElement}"
              BorderBrush="{DynamicResource GpsBorder}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding ScheduleLabel}"
                     FontSize="15"
                     FontWeight="Bold"
                     Foreground="{DynamicResource GpsAccentText}" />
          <ListBox ItemsSource="{Binding ScheduleOptions}"
                   SelectedItem="{Binding ScheduleIntervalDisplay, Mode=TwoWay}"
                   Height="88" />
          <CheckBox Content="{Binding AutoIndexLabel}"
                    IsChecked="{Binding AutoIndexEnabled, Mode=TwoWay}" />
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource GpsElement}"
              BorderBrush="{DynamicResource GpsBorder}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding FavoriteFoldersLabel}"
                     FontSize="15"
                     FontWeight="Bold"
                     Foreground="{DynamicResource GpsAccentText}" />
          <ListBox ItemsSource="{Binding FavoriteFolders}"
                   Height="140">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0"
                             Text="{Binding}"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <Button Grid.Column="1"
                          Content="{Binding $parent[ListBox].DataContext.RemoveFolderLabel}"
                          Command="{Binding $parent[ListBox].DataContext.RemoveFolderCommand}"
                          CommandParameter="{Binding}"
                          Padding="8,2" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Content="{Binding AddFolderLabel}"
                  Command="{Binding AddFolderCommand}"
                  CommandParameter="{Binding $parent[Window]}"
                  HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource GpsElement}"
              BorderBrush="{DynamicResource GpsBorder}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding ThemeLabel}"
                     FontSize="15"
                     FontWeight="Bold"
                     Foreground="{DynamicResource GpsAccentText}" />
          <ListBox ItemsSource="{Binding AvailableThemes}"
                   SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                   Height="120">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <Border Width="14"
                          Height="14"
                          CornerRadius="3"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource GpsBorder}"
                          VerticalAlignment="Center">
                    <Border.Background>
                      <SolidColorBrush Color="{Binding Palette.Background}" />
                    </Border.Background>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Spacing="8">
            <TextBlock Text="{Binding CustomThemeLabel}"
                       FontSize="13"
                       FontWeight="Bold"
                       Opacity="0.9" />
            <Grid ColumnDefinitions="150,*"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="8"
                  RowSpacing="6">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding BackgroundLabel}" VerticalAlignment="Center" />
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CustomBackground, Mode=TwoWay}" />
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ElementLabel}" VerticalAlignment="Center" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CustomElement, Mode=TwoWay}" />
              <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding AdditionalLabel}" VerticalAlignment="Center" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CustomAdditional, Mode=TwoWay}" />
              <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding BorderLabel}" VerticalAlignment="Center" />
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CustomBorder, Mode=TwoWay}" />
              <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding PrimaryTextLabel}" VerticalAlignment="Center" />
              <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CustomPrimaryText, Mode=TwoWay}" />
              <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding AccentTextLabel}" VerticalAlignment="Center" />
              <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding CustomAccentText, Mode=TwoWay}" />
            </Grid>
            <Button Content="{Binding SaveCustomThemeLabel}"
                    Command="{Binding SaveCustomThemeCommand}"
                    HorizontalAlignment="Left" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
