<UserControl x:Class="Guardian.ProgramStation.UI.Views.FullReportView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Guardian.ProgramStation.UI.Converters">
  <UserControl.Resources>
    <converters:ExecutableTypeToIconConverter x:Key="TypeIcon" />
  </UserControl.Resources>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top"
                Orientation="Horizontal"
                Spacing="8"
                Margin="0,0,0,10">
      <Button Content="{Binding AddLabel}" Command="{Binding AddProgramCommand}" />
      <Button Content="{Binding EditLabel}" Command="{Binding EditProgramCommand}" />
      <Button Content="{Binding DeleteLabel}" Command="{Binding DeleteProgramCommand}" />
      <Button Content="{Binding ExportCsvLabel}" Command="{Binding ExportCsvCommand}" />
      <Button Content="{Binding ExportJsonLabel}" Command="{Binding ExportJsonCommand}" />
      <TextBox Width="220"
               Margin="12,0,0,0"
               Watermark="{Binding SearchPlaceholder}"
               Text="{Binding SearchText, Mode=TwoWay}" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Top"
                Orientation="Horizontal"
                Spacing="6"
                Margin="0,0,0,10">
      <TextBlock Text="{Binding TypeColumn}" VerticalAlignment="Center" Margin="0,0,4,0" />
      <Button Content="{Binding AllLabel}" Command="{Binding SetTypeFilterCommand}" CommandParameter="{x:Null}" Padding="10,3" />
      <Button Content="{Binding WindowsLabel}" Command="{Binding SetTypeFilterCommand}" CommandParameter="Windows" Padding="10,3" />
      <Button Content="{Binding LinuxLabel}" Command="{Binding SetTypeFilterCommand}" CommandParameter="Linux" Padding="10,3" />
      <Button Content="{Binding MacOsLabel}" Command="{Binding SetTypeFilterCommand}" CommandParameter="MacOS" Padding="10,3" />
      <Button Content="{Binding SortIndicator}" Command="{Binding ToggleSortCommand}" Margin="12,0,0,0" Padding="10,3" />
    </StackPanel>

    <Grid DockPanel.Dock="Top"
          ColumnDefinitions="Auto,*,*,2*,*,*,2*"
          Margin="6,0,6,4">
      <TextBlock Grid.Column="1" Text="{Binding NameColumn}" FontWeight="Bold" />
      <TextBlock Grid.Column="2" Text="{Binding VersionColumn}" FontWeight="Bold" Margin="6,0,0,0" />
      <TextBlock Grid.Column="3" Text="{Binding PathColumn}" FontWeight="Bold" Margin="6,0,0,0" />
      <TextBlock Grid.Column="4" Text="{Binding LinkColumn}" FontWeight="Bold" Margin="6,0,0,0" />
      <TextBlock Grid.Column="5" Text="{Binding LicenseColumn}" FontWeight="Bold" Margin="6,0,0,0" />
      <TextBlock Grid.Column="6" Text="{Binding NotesColumn}" FontWeight="Bold" Margin="6,0,0,0" />
    </Grid>

    <ListBox ItemsSource="{Binding Programs}"
             SelectedItem="{Binding SelectedProgram, Mode=TwoWay}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="Auto,*,*,2*,*,*,2*">
            <TextBlock Grid.Column="0"
                       Text="{Binding ExecutableType, Converter={StaticResource TypeIcon}}"
                       Foreground="{DynamicResource GpsAccentText}"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Name}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2"
                       Text="{Binding Version}"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="3"
                       Text="{Binding Path}"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="4"
                       Text="{Binding Link}"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="5"
                       Text="{Binding License}"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="6"
                       Text="{Binding Notes}"
                       VerticalAlignment="Center"
                       Margin="6,0,0,0"
                       TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
