<Window x:Class="Guardian.ProgramStation.UI.Views.TreeEditorWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="580"
        Height="560"
        MinWidth="480"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        FlowDirection="{Binding Direction}"
        KeyDown="OnTreeEditorKeyDown">
  <Window.Styles>
    <Style Selector="TextBlock.is-root">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource GpsAccentText}" />
    </Style>
    <Style Selector="TextBox.is-root">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource GpsAccentText}" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,12,0,0">
      <Button Content="{Binding CancelText}" Click="OnCancel" />
      <Button Content="{Binding SaveText}" Click="OnSave" />
    </StackPanel>

    <Grid RowDefinitions="Auto,Auto,*"
          RowSpacing="10">
      <Grid ColumnDefinitions="Auto,*"
            ColumnSpacing="8">
        <TextBlock Text="{Binding ParentFolderLabel}"
                   VerticalAlignment="Center" />
        <TextBox Grid.Column="1"
                 Text="{Binding TreeName, Mode=TwoWay}" />
      </Grid>

      <StackPanel Grid.Row="1"
                  Orientation="Horizontal"
                  Spacing="8">
        <Button Content="{Binding AddRootLabel}"
                Command="{Binding AddRootCommand}"
                CommandParameter="{Binding $parent[Window]}" />
        <Button Content="{Binding AddSubfolderLabel}"
                Command="{Binding AddSubfolderCommand}"
                CommandParameter="{Binding $parent[Window]}" />
      </StackPanel>

      <TreeView Grid.Row="2"
                ItemsSource="{Binding RootNodes}"
                SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
        <TreeView.ItemTemplate>
          <TreeDataTemplate ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        PointerPressed="OnNodeContextMenuPointerPressed">
              <TextBox Text="{Binding Name, Mode=TwoWay}"
                       Width="200"
                       VerticalContentAlignment="Center"
                       Classes.is-root="{Binding IsRoot}" />
              <Button Content="{Binding AddLabel}"
                      Click="OnAddChild"
                      Padding="8,1" />
              <Button Content="{Binding RemoveLabel}"
                      Command="{Binding RemoveCommand}"
                      CommandParameter="{Binding}"
                      Padding="8,1" />
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Grid>

    <Popup x:Name="NodeContextPopup"
           Placement="Pointer"
           IsLightDismissEnabled="True"
           IsOpen="{Binding IsNodeContextMenuOpen, Mode=TwoWay}">
      <Border Background="{DynamicResource GpsElement}"
              BorderBrush="{DynamicResource GpsBorder}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="8"
              MinWidth="180"
              BoxShadow="0 6 16 0 #66000000">
        <StackPanel Spacing="4">
          <Button Content="{Binding CopyLabel}"
                  Command="{Binding CopyCommand}"
                  CommandParameter="{Binding ContextMenuNode}"
                  Click="OnNodeContextAction"
                  HorizontalAlignment="Stretch" />
          <Button Content="{Binding CutLabel}"
                  Command="{Binding CutCommand}"
                  CommandParameter="{Binding ContextMenuNode}"
                  Click="OnNodeContextAction"
                  HorizontalAlignment="Stretch" />
          <Button Content="{Binding PasteLabel}"
                  Command="{Binding PasteCommand}"
                  CommandParameter="{Binding ContextMenuNode}"
                  Click="OnNodeContextAction"
                  HorizontalAlignment="Stretch" />
          <Border Height="1"
                  Background="{DynamicResource GpsBorder}"
                  Margin="0,4" />
          <!-- Name-only actions: copy/paste the node's NAME as plain text. -->
          <Button Content="{Binding CopyNameLabel}"
                  Command="{Binding CopyNameCommand}"
                  CommandParameter="{Binding ContextMenuNode}"
                  Click="OnNodeContextAction"
                  HorizontalAlignment="Stretch" />
          <Button Content="{Binding PasteNameLabel}"
                  Command="{Binding PasteNameCommand}"
                  CommandParameter="{Binding ContextMenuNode}"
                  Click="OnNodeContextAction"
                  HorizontalAlignment="Stretch" />
          <Border Height="1"
                  Background="{DynamicResource GpsBorder}"
                  Margin="0,4" />
          <Button Content="{Binding DeleteLabel}"
                  Command="{Binding DeleteCommand}"
                  CommandParameter="{Binding ContextMenuNode}"
                  Click="OnNodeContextAction"
                  HorizontalAlignment="Stretch" />
        </StackPanel>
      </Border>
    </Popup>
  </DockPanel>
</Window>
