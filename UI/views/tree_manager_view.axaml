<UserControl x:Class="Guardian.ProgramStation.UI.Views.TreeManagerView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid ColumnDefinitions="240,*"
        Margin="16">
    <Grid Grid.Column="0"
          RowDefinitions="Auto,*,Auto">
      <TextBlock Text="{Binding SavedTreesLabel}"
                 FontWeight="Bold"
                 Margin="0,0,0,8" />

      <ListBox Grid.Row="1"
               ItemsSource="{Binding SavedTrees}"
               SelectedItem="{Binding SelectedTree, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0"
                         Text="{Binding Name}"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Content="{Binding $parent[ListBox].DataContext.DeleteTreeLabel}"
                      Click="OnDeleteTree"
                      Padding="8,2" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Row="2"
                  Orientation="Horizontal"
                  Spacing="8"
                  Margin="0,8,0,0">
        <Button Content="{Binding NewLabel}"
                Command="{Binding NewTreeCommand}"
                CommandParameter="{Binding $parent[Window]}" />
        <Button Content="{Binding OpenLabel}" Command="{Binding OpenTreeCommand}" />
        <Button Content="{Binding ImportFromPathLabel}"
                Command="{Binding ImportFromPathCommand}"
                CommandParameter="{Binding $parent[Window]}" />
      </StackPanel>
    </Grid>

    <Grid Grid.Column="1"
          RowDefinitions="Auto,Auto,*,Auto"
          Margin="16,0,0,0">
      <Grid Grid.Row="0"
            ColumnDefinitions="Auto,*"
            Margin="0,0,0,8">
        <TextBlock Text="{Binding TreeNameLabel}"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0" />
        <TextBox Grid.Column="1"
                 Text="{Binding TreeName, Mode=TwoWay}" />
      </Grid>

      <StackPanel Grid.Row="1"
                  Orientation="Horizontal"
                  Spacing="8"
                  Margin="0,0,0,8">
        <Button Content="{Binding SaveLabel}" Command="{Binding SaveTreeCommand}" />
        <Button Content="{Binding SaveAsLabel}" Command="{Binding SaveTreeAsCommand}" />
        <Button Content="{Binding CreateOnDiskLabel}"
                Command="{Binding CreateOnDiskCommand}"
                CommandParameter="{Binding $parent[Window]}" />
        <Button Content="{Binding AddRootLabel}"
                Command="{Binding AddRootCommand}"
                CommandParameter="{Binding $parent[Window]}" />
      </StackPanel>

      <TreeView Grid.Row="2"
                ItemsSource="{Binding RootNodes}"
                SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
        <TreeView.ItemTemplate>
          <TreeDataTemplate ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal"
                        Spacing="8">
              <TextBox Text="{Binding Name, Mode=TwoWay}"
                       Width="160"
                       VerticalContentAlignment="Center" />
              <Button Content="{Binding AddLabel}"
                      Click="OnAddChild"
                      Padding="8,1" />
              <Button Content="{Binding RemoveLabel}"
                      Command="{Binding RemoveCommand}"
                      CommandParameter="{Binding}"
                      Padding="8,1" />
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

      <TextBlock Grid.Row="3"
                 Text="{Binding StatusMessage}"
                 Margin="0,8,0,0"
                 Opacity="0.8"
                 TextTrimming="CharacterEllipsis" />
    </Grid>
  </Grid>
</UserControl>
